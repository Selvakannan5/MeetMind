# ── MeetMind Environment Variables ───────────────────────────────────────────
# Copy this to .env and fill in your values

# HuggingFace token (free) — required for pyannote speaker diarization
# Get yours at: https://huggingface.co/settings/tokens
# Accept terms at: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=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

# Whisper model size (tradeoff: accuracy vs speed)
# base=fast/low-RAM  small=good  medium=better  large-v3=best
WHISPER_MODEL=base
WHISPER_COMPUTE=float16     # int8 (CPU) | float16 (GPU)
WHISPER_DEVICE=cuda       # cpu | cuda

# Ollama LLM for summarization
OLLAMA_MODEL=llama3      # llama3 | mistral | phi3

# Database (SQLite default, swap for PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./meetmind.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/meetmind

# Redis
REDIS_URL=redis://localhost:6379

# Frontend API base URL
VITE_API_URL=http://localhost:8081
